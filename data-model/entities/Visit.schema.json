    "visit_id": {
      "type": "string",
      "description": "Reconciled attendance system",
      "x-requirement": "required",
      "x-privacy": "private operational",
      "x-sensitive": false,
      "minLength": 1
    },
    "customer_id": {
      "type": "string",
      "description": "Reconciled attendance system",
      "x-requirement": "required",
      "x-privacy": "private operational",
      "x-sensitive": false,
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "description": "Reconciled attendance system",
      "x-requirement": "required",
      "x-privacy": "private operational",
      "x-sensitive": false,
      "minLength": 1
    },
    "booking_id": {
      "type": "string",
      "description": "Reconciled attendance system",
      "x-requirement": "required",
      "x-privacy": "private operational",
      "x-sensitive": false,
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Reconciled attendance system",
      "x-requirement": "required",
      "x-privacy": "private operational",
      "x-sensitive": false,
      "minLength": 1
